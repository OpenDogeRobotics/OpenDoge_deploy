[Unit]
Description=OpenDoge Gamepad Driver / Readiness (xboxdrv or native js0)
Documentation=https://github.com/Lain-Ego/OpenDoge_firmware
After=multi-user.target
Wants=multi-user.target
# No limit on restart count (clone dongles can be flaky).
StartLimitIntervalSec=0

[Service]
Type=simple
# start_gamepad.sh supports:
#   413d:2104 Xbox dongle -> xboxdrv creates /dev/input/js0
#   3537:1041 Zikway      -> kernel hid-generic/joydev creates js0 (no xboxdrv)
# __REPO_ROOT__ is substituted by scripts/install_services.sh.
ExecStart=/bin/sh __REPO_ROOT__/scripts/start_gamepad.sh
# Always restart on exit — handles dongle ENODEV / receiver mode switches.
Restart=always
RestartSec=5
TimeoutStartSec=45
# Cleanup: kill any stale xboxdrv before starting.
ExecStopPost=-/bin/sh -c 'killall xboxdrv 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
